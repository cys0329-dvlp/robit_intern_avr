#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>


// =====================================================
// 설정
// =====================================================

#define BAUD 9600
#define UBRR_VALUE ((F_CPU / 16UL / BAUD) - 1)


// -----------------------------------------------------
// LCD I2C 주소
// -----------------------------------------------------

#define LCD_I2C_ADDR 0x27


// -----------------------------------------------------
// LED
// -----------------------------------------------------

#define LED_ID1 PA5
#define LED_ID2 PA3


// -----------------------------------------------------
// HuskyLens
// -----------------------------------------------------

#define HUSKY_HEADER1       0x55
#define HUSKY_HEADER2       0xAA
#define HUSKY_ADDRESS       0x11

#define HUSKY_REQUEST_BLOCKS 0x21
#define HUSKY_RETURN_INFO    0x29
#define HUSKY_RETURN_BLOCK   0x2A

#define UART_TIMEOUT 60000UL


// =====================================================
// 전역 변수
// =====================================================

// ID 1
uint8_t  id1_detected = 0;
uint16_t id1_x = 0;
uint16_t id1_y = 0;


// ID 2
uint8_t  id2_detected = 0;
uint16_t id2_x = 0;
uint16_t id2_y = 0;


// =====================================================
// LED
// =====================================================

void LED_Init(void)
{
	DDRA |= (1 << LED_ID1);
	DDRA |= (1 << LED_ID2);

	PORTA &= ~(1 << LED_ID1);
	PORTA &= ~(1 << LED_ID2);
}


void LED_Update(void)
{
	// ID 1
	if (id1_detected)
	PORTA |= (1 << LED_ID1);
	else
	PORTA &= ~(1 << LED_ID1);


	// ID 2
	if (id2_detected)
	PORTA |= (1 << LED_ID2);
	else
	PORTA &= ~(1 << LED_ID2);
}


// =====================================================
// UART0
//
// HuskyLens TX -> PE0 RXD0
// HuskyLens RX <- PE1 TXD0
// =====================================================

void UART0_Init(void)
{
	UBRR0H = (uint8_t)(UBRR_VALUE >> 8);
	UBRR0L = (uint8_t)UBRR_VALUE;

	UCSR0A = 0x00;

	UCSR0B =
	(1 << RXEN0) |
	(1 << TXEN0);

	UCSR0C =
	(1 << UCSZ01) |
	(1 << UCSZ00);
}


void UART0_SendByte(uint8_t data)
{
	while (!(UCSR0A & (1 << UDRE0)));

	UDR0 = data;
}


uint8_t UART0_ReadByteTimeout(uint8_t *data)
{
	uint32_t timeout = UART_TIMEOUT;

	while (!(UCSR0A & (1 << RXC0)))
	{
		if (--timeout == 0)
		{
			return 0;
		}
	}

	*data = UDR0;

	return 1;
}


void UART0_ClearBuffer(void)
{
	while (UCSR0A & (1 << RXC0))
	{
		volatile uint8_t dummy = UDR0;
		(void)dummy;
	}
}


// =====================================================
// HuskyLens 요청
//
// 55 AA 11 00 21 31
// =====================================================

void HuskyLens_RequestBlocks(void)
{
	UART0_SendByte(0x55);
	UART0_SendByte(0xAA);
	UART0_SendByte(0x11);
	UART0_SendByte(0x00);
	UART0_SendByte(0x21);
	UART0_SendByte(0x31);
}


// =====================================================
// HuskyLens 패킷 수신
// =====================================================

uint8_t HuskyLens_ReadPacket(uint8_t *buffer)
{
	uint8_t data;
	uint8_t length;
	uint8_t index = 0;

	uint8_t checksum = 0;


	// -------------------------------------------------
	// 0x55 찾기
	// -------------------------------------------------

	while (1)
	{
		if (!UART0_ReadByteTimeout(&data))
		{
			return 0;
		}

		if (data == HUSKY_HEADER1)
		{
			break;
		}
	}

	buffer[index++] = data;


	// -------------------------------------------------
	// 0xAA
	// -------------------------------------------------

	if (!UART0_ReadByteTimeout(&data))
	return 0;

	if (data != HUSKY_HEADER2)
	return 0;

	buffer[index++] = data;


	// -------------------------------------------------
	// Address
	// -------------------------------------------------

	if (!UART0_ReadByteTimeout(&data))
	return 0;

	if (data != HUSKY_ADDRESS)
	return 0;

	buffer[index++] = data;


	// -------------------------------------------------
	// Length
	// -------------------------------------------------

	if (!UART0_ReadByteTimeout(&length))
	return 0;

	buffer[index++] = length;


	if (length > 30)
	return 0;


	// -------------------------------------------------
	// Command + Data
	// -------------------------------------------------

	for (uint8_t i = 0; i < length + 1; i++)
	{
		if (!UART0_ReadByteTimeout(&data))
		return 0;

		buffer[index++] = data;
	}


	// -------------------------------------------------
	// Checksum
	// -------------------------------------------------

	if (!UART0_ReadByteTimeout(&data))
	return 0;

	buffer[index++] = data;


	// -------------------------------------------------
	// Checksum 계산
	//
	// Header부터 Data까지 전부 더함
	// -------------------------------------------------

	for (uint8_t i = 0; i < index - 1; i++)
	{
		checksum += buffer[i];
	}


	if (checksum != buffer[index - 1])
	{
		return 0;
	}


	return 1;
}


// =====================================================
// 16bit Little Endian
// =====================================================

uint16_t GetUInt16(uint8_t low, uint8_t high)
{
	return ((uint16_t)high << 8) | low;
}


// =====================================================
// HuskyLens 데이터 처리
// =====================================================

uint8_t HuskyLens_Update(void)
{
	uint8_t packet[40];

	uint16_t block_count;


	// -------------------------------------------------
	// 이전 인식 상태 초기화
	// -------------------------------------------------

	id1_detected = 0;
	id2_detected = 0;


	// -------------------------------------------------
	// UART 버퍼 비우기
	// -------------------------------------------------

	UART0_ClearBuffer();


	// -------------------------------------------------
	// HuskyLens에 BLOCK 요청
	// -------------------------------------------------

	HuskyLens_RequestBlocks();


	// -------------------------------------------------
	// RETURN_INFO 수신
	// -------------------------------------------------

	if (!HuskyLens_ReadPacket(packet))
	{
		return 0;
	}


	if (packet[4] != HUSKY_RETURN_INFO)
	{
		return 0;
	}


	// -------------------------------------------------
	// 검출된 BLOCK 개수
	//
	// packet[5] = Low
	// packet[6] = High
	// -------------------------------------------------

	block_count =
	GetUInt16(packet[5], packet[6]);


	// -------------------------------------------------
	// BLOCK들을 모두 읽음
	// -------------------------------------------------

	for (uint16_t i = 0; i < block_count; i++)
	{
		uint16_t id;
		uint16_t x;
		uint16_t y;


		if (!HuskyLens_ReadPacket(packet))
		{
			break;
		}


		// BLOCK인지 확인
		if (packet[4] != HUSKY_RETURN_BLOCK)
		{
			continue;
		}


		// -------------------------------------------------
		// 좌표
		// -------------------------------------------------

		x = GetUInt16(packet[5], packet[6]);

		y = GetUInt16(packet[7], packet[8]);


		// -------------------------------------------------
		// ID
		// -------------------------------------------------

		id = GetUInt16(packet[13], packet[14]);


		// -------------------------------------------------
		// ID 1
		// -------------------------------------------------

		if (id == 1)
		{
			id1_detected = 1;

			id1_x = x;
			id1_y = y;
		}


		// -------------------------------------------------
		// ID 2
		// -------------------------------------------------

		else if (id == 2)
		{
			id2_detected = 1;

			id2_x = x;
			id2_y = y;
		}
	}


	return 1;
}


// =====================================================
// I2C / TWI
//
// ATmega128
//
// PD0 = SCL
// PD1 = SDA
// =====================================================

#define TWBR_VALUE 72


void I2C_Init(void)
{
	// SCL / SDA 입력
	DDRD &= ~(1 << PD0);
	DDRD &= ~(1 << PD1);


	// 내부 Pull-up
	PORTD |= (1 << PD0);
	PORTD |= (1 << PD1);


	// TWI Bit Rate
	TWBR = TWBR_VALUE;

	// Prescaler = 1
	TWSR = 0x00;


	// TWI Enable
	TWCR = (1 << TWEN);
}


// =====================================================
// I2C START
// =====================================================

uint8_t I2C_Start(uint8_t address)
{
	// START
	TWCR =
	(1 << TWINT) |
	(1 << TWSTA) |
	(1 << TWEN);

	while (!(TWCR & (1 << TWINT)));


	// SLA + W/R
	TWDR = address;

	TWCR =
	(1 << TWINT) |
	(1 << TWEN);

	while (!(TWCR & (1 << TWINT)));


	return 1;
}


// =====================================================
// I2C STOP
// =====================================================

void I2C_Stop(void)
{
	TWCR =
	(1 << TWINT) |
	(1 << TWEN) |
	(1 << TWSTO);

	_delay_us(10);
}


// =====================================================
// I2C 데이터 전송
// =====================================================

void I2C_Write(uint8_t data)
{
	TWDR = data;

	TWCR =
	(1 << TWINT) |
	(1 << TWEN);

	while (!(TWCR & (1 << TWINT)));
}


// =====================================================
// LCD I2C
// =====================================================

// 일반적인 PCF8574 LCD backpack
//
// P0 = RS
// P1 = RW
// P2 = EN
// P3 = Backlight
// P4 = D4
// P5 = D5
// P6 = D6
// P7 = D7
// =====================================================

#define LCD_RS 0x01
#define LCD_RW 0x02
#define LCD_EN 0x04
#define LCD_BL 0x08


void LCD_ExpanderWrite(uint8_t data)
{
	I2C_Start((LCD_I2C_ADDR << 1) | 0);

	I2C_Write(data | LCD_BL);

	I2C_Stop();
}


void LCD_Enable(uint8_t data)
{
	LCD_ExpanderWrite(data | LCD_EN);

	_delay_us(1);

	LCD_ExpanderWrite(data & ~LCD_EN);

	_delay_us(50);
}


void LCD_Send4Bit(uint8_t data)
{
	LCD_ExpanderWrite(data);

	LCD_Enable(data);
}


void LCD_SendCommand(uint8_t command)
{
	uint8_t high;
	uint8_t low;


	high = command & 0xF0;
	low  = (command << 4) & 0xF0;


	LCD_Send4Bit(high);
	LCD_Send4Bit(low);


	if (command == 0x01 ||
	command == 0x02)
	{
		_delay_ms(2);
	}
}


void LCD_SendData(uint8_t data)
{
	uint8_t high;
	uint8_t low;


	high = (data & 0xF0) | LCD_RS;
	low  = ((data << 4) & 0xF0) | LCD_RS;


	LCD_Send4Bit(high);
	LCD_Send4Bit(low);
}


void LCD_Clear(void)
{
	LCD_SendCommand(0x01);

	_delay_ms(2);
}


void LCD_SetCursor(uint8_t row, uint8_t col)
{
	uint8_t address;


	if (row == 0)
	address = 0x80 + col;
	else
	address = 0xC0 + col;


	LCD_SendCommand(address);
}


void LCD_Print(const char *str)
{
	while (*str)
	{
		LCD_SendData(*str++);
	}
}


void LCD_Init(void)
{
	_delay_ms(50);


	// 초기화
	LCD_ExpanderWrite(0x00);

	_delay_ms(5);


	// 8bit mode
	LCD_Send4Bit(0x30);

	_delay_ms(5);

	LCD_Send4Bit(0x30);

	_delay_us(150);

	LCD_Send4Bit(0x30);


	// 4bit mode
	LCD_Send4Bit(0x20);


	// Function Set
	LCD_SendCommand(0x28);


	// Display OFF
	LCD_SendCommand(0x08);


	// Clear
	LCD_SendCommand(0x01);


	// Entry Mode
	LCD_SendCommand(0x06);


	// Display ON
	LCD_SendCommand(0x0C);


	LCD_Clear();
}


// =====================================================
// 숫자 출력
// =====================================================

void LCD_PrintUInt(uint16_t value)
{
	char buffer[6];

	uint8_t i = 0;


	if (value == 0)
	{
		LCD_SendData('0');
		return;
	}


	while (value > 0)
	{
		buffer[i++] = '0' + (value % 10);
		value /= 10;
	}


	while (i > 0)
	{
		LCD_SendData(buffer[--i]);
	}
}


// =====================================================
// 정수 제곱근
//
// sqrt()를 사용하지 않고 계산
// AVR에서 가볍게 사용 가능
// =====================================================

uint16_t IntegerSqrt(uint32_t value)
{
	uint32_t result = 0;
	uint32_t bit = 1UL << 30;


	while (bit > value)
	{
		bit >>= 2;
	}


	while (bit != 0)
	{
		if (value >= result + bit)
		{
			value -= result + bit;

			result = (result >> 1) + bit;
		}
		else
		{
			result >>= 1;
		}

		bit >>= 2;
	}


	return (uint16_t)result;
}


// =====================================================
// 두 태그 거리 계산
//
// distance = sqrt(
//     (X2-X1)^2 +
//     (Y2-Y1)^2
// )
//
// 결과 단위 = pixel
// =====================================================

uint16_t CalculateDistance(void)
{
	int32_t dx;
	int32_t dy;

	uint32_t distance_squared;


	dx = (int32_t)id2_x - (int32_t)id1_x;

	dy = (int32_t)id2_y - (int32_t)id1_y;


	distance_squared =
	(uint32_t)(dx * dx) +
	(uint32_t)(dy * dy);


	return IntegerSqrt(distance_squared);
}


// =====================================================
// LCD 화면 업데이트
// =====================================================

void LCD_Update(void)
{
	uint16_t distance;


	LCD_Clear();


	// -------------------------------------------------
	// 첫 번째 줄
	// -------------------------------------------------

	LCD_SetCursor(0, 0);

	LCD_Print("ID1:");

	if (id1_detected)
	LCD_Print("ON ");
	else
	LCD_Print("OFF");


	LCD_Print(" ID2:");

	if (id2_detected)
	LCD_Print("ON");
	else
	LCD_Print("OFF");


	// -------------------------------------------------
	// 두 번째 줄
	// -------------------------------------------------

	LCD_SetCursor(1, 0);


	if (id1_detected && id2_detected)
	{
		distance = CalculateDistance();


		LCD_Print("D:");

		LCD_PrintUInt(distance);

		LCD_Print(" px");
	}
	else
	{
		LCD_Print("D: -- px");
	}
}


// =====================================================
// MAIN
// =====================================================

int main(void)
{
	// -------------------------------------------------
	// 초기화
	// -------------------------------------------------

	LED_Init();

	UART0_Init();

	I2C_Init();

	LCD_Init();


	// HuskyLens 부팅 대기
	_delay_ms(2000);


	// 시작 화면
	LCD_Clear();

	LCD_SetCursor(0, 0);
	LCD_Print("HuskyLens");

	LCD_SetCursor(1, 0);
	LCD_Print("Starting...");

	_delay_ms(1000);


	// -------------------------------------------------
	// Main Loop
	// -------------------------------------------------

	while (1)
	{
		// HuskyLens 데이터 갱신
		HuskyLens_Update();


		// ID1 / ID2 LED
		LED_Update();


		// LCD 거리 표시
		LCD_Update();


		// 너무 빠른 LCD 갱신 방지
		_delay_ms(100);
	}
}
